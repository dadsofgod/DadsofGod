{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/fulfill.js": {
      "maxDuration": 60
    },
    "api/paypal-webhook.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/:path((?!api(?:/|$)).*)",
      "destination": "https://www.dadsofgod.com/:path",
      "permanent": true
    }
  ]
}
